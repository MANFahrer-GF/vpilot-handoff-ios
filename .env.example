# Copy to .env and fill in your own Apple Development Team ID before running
# `xcodegen generate`. Find it in Xcode > Settings > Accounts > (your Apple ID)
# > Manage Certificates, or on developer.apple.com under Membership.
#
#   cp .env.example .env && source .env && xcodegen generate
#
# A free personal Apple ID works for installing on your own iPad; the app then
# has to be reinstalled every 7 days, which is an Apple limitation.
export DEVELOPMENT_TEAM=
