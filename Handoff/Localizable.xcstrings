    "TAP A ROW TO CHANGE ITS COLOUR": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZEILE ANTIPPEN, UM IHRE FARBE ZU ÄNDERN"
          }
        }
      }
    },
    "CONTACT-ME ALERT": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CONTACT-ME-ALARM"
          }
        }
      }
    },
    "An unresolved contact-me request flashes a station's row between its own colour and this alert colour twice a second.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine offene Contact-me-Anfrage lässt die Zeile zweimal pro Sekunde zwischen ihrer eigenen Farbe und dieser Alarmfarbe blinken."
          }
        }
      }
    },
    "NON-HIGHLIGHT BRIGHTNESS": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HELLIGKEIT NICHT-HERVORGEHOBENER ZEILEN"
          }
        }
      }
    },
    "Where default (non-highlighted) rows sit between black and white, relative to their highlighted colour.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo normale (nicht hervorgehobene) Zeilen zwischen Schwarz und Weiß liegen, relativ zu ihrer Hervorhebungsfarbe."
          }
        }
      }
    },
    "Black": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwarz"
          }
        }
      }
    },
