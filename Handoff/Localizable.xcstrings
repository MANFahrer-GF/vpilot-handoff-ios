    "DARK MODE OFFSET": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DARK-MODE-ABDUNKLUNG"
          }
        }
      }
    },
    "Extra darkening applied to every row — highlighted included — only in the dark appearance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Abdunklung auf jeder Zeile — auch hervorgehobenen — nur im dunklen Erscheinungsbild."
          }
        }
      }
    },
