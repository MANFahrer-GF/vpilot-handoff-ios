      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervorhebung"
          }
        }
      }
    },
    "White": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiß"
          }
        }
      }
    },
    "TEXT CONTRAST THRESHOLD": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TEXTKONTRAST-SCHWELLE"
          }
        }
      }
    },
    "When row text switches from dark to white as a colour darkens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab wann der Zeilentext von Dunkel auf Weiß wechselt, wenn eine Farbe dunkler wird."
          }
        }
      }
    },
    "Early": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh"
          }
        }
      }
    },
