    "Slow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam"
          }
        }
      }
    },
    "How often the controller list and radio state refresh. \"Slow\" helps if the display feels sluggish.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft Controller-Liste und Funkstatus aktualisiert werden. „Langsam“ hilft, wenn die Darstellung träge wirkt."
          }
        }
      }
    },
    "DIAGNOSTICS": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DIAGNOSE"
          }
        }
      }
    },
    "Debug mode": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Modus"
          }
        }
      }
    },
    "Shows the ranking rationale per controller and allows a diagnostic snapshot for plugin development.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Ranking-Begründung pro Controller und erlaubt einen Diagnose-Schnappschuss für die Plugin-Entwicklung."
          }
        }
      }
    },
    "Attach screenshot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot anhängen"
          }
        }
      }
    },
    "Attaches an image of the Handoff window to the snapshot. That window only — iOS never lets an app photograph other apps, unlike the Android version's full-screen option.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt ein Bild des Handoff-Fensters an den Schnappschuss. Nur dieses Fenster — iOS erlaubt keiner App, andere Apps mitzufotografieren, anders als die Vollbild-Option der Android-Version."
          }
        }
      }
    },
    "Save diagnostic snapshot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose-Schnappschuss speichern"
          }
        }
      }
    },
