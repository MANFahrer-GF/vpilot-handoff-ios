    },
    "Pairing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung"
          }
        }
      }
    },
    "This PC's identity has changed since it was last paired. The connection was refused and nothing was sent to it. That happens after reinstalling or resetting the plugin — but it can also mean something else is impersonating it. Only enter the code if you just reinstalled or reset the plugin yourself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identität dieses PCs hat sich seit der letzten Kopplung geändert. Die Verbindung wurde abgelehnt und es wurde nichts an ihn gesendet. Das passiert nach einer Neuinstallation oder einem Zurücksetzen des Plugins — es kann aber auch bedeuten, dass sich etwas anderes dafür ausgibt. Gib den Code nur ein, wenn du das Plugin gerade selbst neu installiert oder zurückgesetzt hast."
          }
        }
      }
    },
    "Enter the code shown on the PC (%@) to pair this iPad with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code ein, der auf dem PC (%@) angezeigt wird, um dieses iPad zu koppeln."
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Pair": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln"
          }
        }
      }
    },
    "Wrong code — please try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falscher Code — bitte erneut versuchen."
          }
        }
      }
